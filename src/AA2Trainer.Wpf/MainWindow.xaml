<Window x:Class="AA2Trainer.WpfPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AA2Trainer.WpfPrototype.Views"
        Title="AA2 Trainer"
        Width="1180" Height="760"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="MainWindow_Loaded"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate x:Key="SeatRailTemplate">
            <Grid x:Name="SeatRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Rectangle x:Name="SeatDot" Grid.Column="0"
                           Width="3"
                           Fill="{DynamicResource Success}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Stretch"
                           Margin="0,1,0,1"
                           RadiusX="1" RadiusY="1" />
                <Rectangle x:Name="SeatLimitDot" Grid.Column="0"
                           Width="3" Height="6"
                           Fill="{DynamicResource Danger}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,1"
                           RadiusX="1" RadiusY="1">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActionLimits}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <Border Grid.Column="1"
                        Width="28" Height="28"
                        CornerRadius="14"
                        Background="{DynamicResource AccentSoft}"
                        ClipToBounds="True"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding Initial}"
                                   Foreground="{DynamicResource Accent}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Image Source="{Binding RosterImage}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                                <EllipseGeometry Center="14,14"
                                                 RadiusX="14"
                                                 RadiusY="14" />
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>

                <StackPanel x:Name="SeatText" Grid.Column="2" Margin="6,0,0,0"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Seat}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,0,4,0" />
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding RoomAction}"
                               Style="{StaticResource CaptionText}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Popup x:Name="SeatFacePreview"
                       Placement="Custom"
                       PlacementTarget="{Binding ElementName=SeatRow}"
                       Loaded="SeatFacePreview_Loaded"
                       AllowsTransparency="True"
                       StaysOpen="True"
                       IsHitTestVisible="False"
                       PopupAnimation="Fade">
                    <Popup.Style>
                        <Style TargetType="Popup">
                            <Setter Property="IsOpen" Value="False" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, ElementName=SeatRow}" Value="True" />
                                        <Condition Binding="{Binding HasCardFace}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsOpen" Value="True" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Popup.Style>
                    <Border Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6">
                        <StackPanel>
                            <Grid Width="200" Height="300"
                                  Background="{DynamicResource SurfaceAlt}">
                                <TextBlock Text="No card face"
                                           Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Image Source="{Binding CardFaceImage}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,6,0,0">
                                <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Seat}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMuted}" />
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding RoomAction}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.RailCollapsed, RelativeSource={RelativeSource AncestorType=ListBox}}"
                             Value="True">
                    <Setter TargetName="SeatText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Busy">
                    <Setter TargetName="SeatDot" Property="Fill" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Talking">
                    <Setter TargetName="SeatDot" Property="Fill" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Roaming">
                    <Setter TargetName="SeatDot" Property="Fill" Value="{DynamicResource TextMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Moving">
                    <Setter TargetName="SeatDot" Property="Fill" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Approaching">
                    <Setter TargetName="SeatDot" Property="Fill" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Training">
                    <Setter TargetName="SeatDot" Property="Fill" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Facing">
                    <Setter TargetName="SeatDot" Property="Fill" Value="{DynamicResource TextMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Empty">
                    <Setter TargetName="SeatDot" Property="Fill" Value="{DynamicResource TextDisabled}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="LogLineTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}"
                           Style="{StaticResource MonoText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="0,0,8,0" />
                <Border Grid.Column="1"
                        Width="1"
                        Background="{DynamicResource Border}"
                        Margin="0,2,8,2" />
                <TextBlock x:Name="LineText" Grid.Column="2"
                           Text="{Binding Text}"
                           Style="{StaticResource MonoText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Detail">
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource TextMuted}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" ClipToBounds="True">
                    <TextBlock Text="AA2 Trainer" FontSize="14" FontWeight="SemiBold" />
                    <Border Style="{StaticResource Pill}" Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource AccentSoft}" Margin="8,0,10,0">
                        <TextBlock Text="PROTOTYPE" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}" />
                    </Border>
                    <Ellipse Width="8" Height="8"
                             Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAttached}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding AttachState}" VerticalAlignment="Center" />
                    <Border Width="1" Height="16" Background="{DynamicResource Border}" Margin="10,0" />
                    <Button x:Name="ScheduleButton"
                            Content="{Binding GameTime}"
                            Style="{StaticResource ToolbarButton}"
                            Padding="6,2"
                            Click="ScheduleButton_Click"
                            ToolTip="Edit the class schedule or freeze time" />
                    <Popup x:Name="SchedulePopup"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=ScheduleButton}"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel Width="380">
                                <TextBlock Text="Schedule"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="0,0,0,6" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Weekday"
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding WeekdayOptions}"
                                              SelectedIndex="{Binding ScheduleDraft.Weekday, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="Week"
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                    <ComboBox Grid.Column="3"
                                              ItemsSource="{Binding WeekOptions}"
                                              SelectedIndex="{Binding ScheduleDraft.WeekIndex, Mode=TwoWay}" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Period"
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding PeriodOptions}"
                                              SelectedIndex="{Binding ScheduleDraft.Period, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="Duration"
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                    <TextBox Grid.Column="3"
                                             Text="{Binding ScheduleDraft.Duration, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                             ToolTip="Period duration in minutes (1-60)" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Time"
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="54"
                                                 Text="{Binding ScheduleDraft.Minute, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="Minutes (0-59)" />
                                        <TextBlock Text=":"
                                                   Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center"
                                                   Margin="2,0" />
                                        <TextBox Width="54"
                                                 Text="{Binding ScheduleDraft.Second, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="Seconds (0-59)" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2"
                                              Content="Freeze time"
                                              IsChecked="{Binding IsTimeFrozen, Mode=OneWay}"
                                              Checked="TimeFreeze_Changed"
                                              Unchecked="TimeFreeze_Changed"
                                              VerticalAlignment="Center"
                                              Margin="10,0,0,0"
                                              ToolTip="Pin the selected time every 50 ms" />
                                </Grid>

                                <TextBlock Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0">
                                    <Run Text="Academy: " />
                                    <Run Text="{Binding ScheduleDraft.Academy, Mode=OneWay}" />
                                    <Run Text="  Year: " />
                                    <Run Text="{Binding ScheduleDraft.Year, Mode=OneWay}" />
                                    <Run Text="  Class: " />
                                    <Run Text="{Binding ScheduleDraft.ClassNumber, Mode=OneWay}" />
                                    <Run Text="  Save: " />
                                    <Run Text="{Binding ScheduleDraft.SaveName, Mode=OneWay}" />
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Apply" Width="76"
                                            IsEnabled="{Binding CanApplySchedule}"
                                            Click="ApplySchedule_Click" />
                                    <Button Content="Revert" Width="76"
                                            Margin="6,0,0,0"
                                            IsEnabled="{Binding CanRevertSchedule}"
                                            Click="RevertSchedule_Click" />
                                    <TextBlock Text="{Binding ScheduleStatus}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Border Width="1" Height="16" Background="{DynamicResource Border}" Margin="10,0" />
                    <TextBlock Text="{Binding PointerHealth}" Style="{StaticResource CaptionText}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Button Content="{Binding AttachButtonText}"
                            Style="{StaticResource ToolbarButton}"
                            Margin="0,0,6,0"
                            ToolTip="Attach to or detach from AA2Play"
                            Click="AttachButton_Click" />
                    <TextBlock Text="Theme" Style="{StaticResource CaptionText}" Margin="0,0,4,0" />
                    <ComboBox x:Name="ThemeCombo" Width="92" SelectedIndex="0"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="System" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                    <Button Content="&#xE72C;" Style="{StaticResource IconButton}"
                            ToolTip="Refresh game data"
                            Click="Refresh_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SeatRailColumn" Width="220" />
                <ColumnDefinition x:Name="SeatSplitterColumn" Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Seat rail -->
            <Border x:Name="SeatRailBorder" Grid.Column="0"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,0,6,0">
                        <TextBlock x:Name="RailHeaderText" Text="Class seats"
                                   Style="{StaticResource SectionHeader}" />
                        <Button x:Name="CollapseRailButton"
                                Content="&#xE76B;"
                                Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right"
                                ToolTip="Collapse seat rail"
                                Click="CollapseRail_Click" />
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Seats}"
                             SelectedItem="{Binding SelectedSeat, Mode=TwoWay}"
                             ItemTemplate="{StaticResource SeatRailTemplate}"
                             ItemContainerStyle="{StaticResource SeatItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling" />

                    <TextBlock x:Name="RailFooterText" Grid.Row="2"
                               Text="25 seats | live"
                               Style="{StaticResource CaptionText}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" />

            <!-- Content -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderRow" Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="LogSplitterRow" Height="4" />
                    <RowDefinition x:Name="LogRow" Height="170" />
                </Grid.RowDefinitions>

                <!-- Character header -->
                <Border x:Name="CharacterHeaderBorder" Grid.Row="0"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="44" Height="44" CornerRadius="22"
                                Background="{DynamicResource AccentSoft}"
                                ClipToBounds="True"
                                VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="{Binding SelectedSeat.Initial}"
                                           Foreground="{DynamicResource Accent}"
                                           FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Image Source="{Binding SelectedSeat.RosterImage}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <EllipseGeometry Center="22,22"
                                                         RadiusX="22"
                                                         RadiusY="22" />
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedSeat.Name}"
                                           FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Seat " Style="{StaticResource CaptionText}"
                                           Margin="10,0,2,0" />
                                <TextBlock Text="{Binding SelectedSeat.Seat}"
                                           Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedSeat.RoomAction}"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="{Binding SelectedSeat.HeaderRelationship}"
                                           FontSize="10"
                                           Foreground="{DynamicResource Accent}" />
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="{Binding WriteGate}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMuted}" />
                            </Border>
                            <Button Content="Play as"
                                    Click="PlayAs_Click"
                                    ToolTip="Make the selected character the player">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource ToolbarButton}">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSeat.IsPc}"
                                                         Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedSeat.HasName}"
                                                         Value="False">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main tabs -->
                <TabControl x:Name="MainTabs" Grid.Row="1"
                            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                            SelectionChanged="MainTabs_SelectionChanged">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="Roster" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:RosterView />
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="Character" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:CharacterView />
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="Gameplay" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:GameplayView />
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="Options" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:OptionsView />
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="Debug" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:DebugView />
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Row="2" Height="4" />

                <!-- Log drawer -->
                <Border x:Name="LogPanel" Grid.Row="3"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="8,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LiveLogTab"
                                             Content="Live events"
                                             Style="{StaticResource LogTabStyle}"
                                             GroupName="LogTabs"
                                             IsChecked="True"
                                             Checked="LiveLogTab_Checked" />
                                <RadioButton x:Name="PlannerLogTab"
                                             Content="Planner log"
                                             Style="{StaticResource LogTabStyle}"
                                             GroupName="LogTabs"
                                             Checked="PlannerLogTab_Checked" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="Clear" Style="{StaticResource ToolbarButton}"
                                        Click="ClearLog_Click" />
                                <Button Content="Save" Style="{StaticResource ToolbarButton}"
                                        Margin="6,0,0,0" IsEnabled="False"
                                        ToolTip="Wired in M3" />
                                <Button x:Name="CollapseLogButton"
                                        Content="&#xE70E;"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Collapse log"
                                        Click="CollapseLog_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" x:Name="LogContent">
                            <ListBox x:Name="LiveLogList"
                                     ItemsSource="{Binding LiveLines}"
                                     ItemTemplate="{StaticResource LogLineTemplate}"
                                     ItemContainerStyle="{StaticResource LogItemStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling" />
                            <ListBox x:Name="PlannerLogList"
                                     ItemsSource="{Binding PlannerLines}"
                                     ItemTemplate="{StaticResource LogLineTemplate}"
                                     ItemContainerStyle="{StaticResource LogItemStyle}"
                                     Visibility="Collapsed"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock Text="{Binding WriteGate}" Style="{StaticResource CaptionText}" />
                    <Border Width="1" Height="12" Background="{DynamicResource Border}" Margin="10,0" />
                    <TextBlock Text="{Binding PointerHealth}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            ClipToBounds="True">
                    <TextBlock Text="Portable | AA2Trainer.ini" Style="{StaticResource CaptionText}" />
                    <Border Width="1" Height="12" Background="{DynamicResource Border}" Margin="10,0" />
