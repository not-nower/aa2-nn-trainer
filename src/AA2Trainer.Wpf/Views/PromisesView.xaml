<UserControl x:Class="AA2Trainer.WpfPrototype.Views.PromisesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Active promises involving the selected character (read-only)."
                   Style="{StaticResource CaptionText}"
                   Margin="0,0,0,8" />

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding PromiseRows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Direction"
                                    Width="90"
                                    Binding="{Binding Direction}" />
                <DataGridTextColumn Header="Kind"
                                    Width="80"
                                    Binding="{Binding Kind}" />
                <DataGridTextColumn Header="Other"
                                    Width="*"
                                    Binding="{Binding OtherText}" />
                <DataGridTextColumn Header="Location"
                                    Width="80"
                                    Binding="{Binding Location}" />
                <DataGridTextColumn Header="Test"
                                    Width="64"
                                    Binding="{Binding TestType}" />
                <DataGridTextColumn Header="Flag"
                                    Width="60"
                                    Binding="{Binding Flag}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
