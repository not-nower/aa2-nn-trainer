<UserControl x:Class="AA2Trainer.WpfPrototype.Views.GameplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AA2Trainer.WpfPrototype.Views">
    <TabControl>
        <TabItem Header="Planner">
            <views:PlannerView />
        </TabItem>
        <TabItem Header="Limits">
            <TextBlock Text="Prototype - Limits in M3."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
        <TabItem Header="Relationship">
            <TextBlock Text="Prototype - Relationship in M3."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
        <TabItem Header="Behavior">
            <TextBlock Text="Prototype - Behavior History in M3."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
        <TabItem Header="Lover">
            <TextBlock Text="Prototype - Lover in M3."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
        <TabItem Header="Promises">
            <TextBlock Text="Prototype - Promises in M3."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
    </TabControl>
</UserControl>
