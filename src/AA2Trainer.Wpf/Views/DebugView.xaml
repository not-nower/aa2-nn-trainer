<UserControl x:Class="AA2Trainer.WpfPrototype.Views.DebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DebugRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="EMPTY">
                    <Setter Property="Opacity" Value="0.7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="SUSPICIOUS">
                    <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="BROKEN">
                    <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="UNREADABLE">
                    <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DebugStatusStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="OK">
                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="EMPTY">
                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="SUSPICIOUS">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Live game memory" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Read-only values read directly from the game."
                       Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding DebugCountText}"
                       Style="{StaticResource CaptionText}" />
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ComboBox Width="130"
                      ItemsSource="{Binding DebugCategories}"
                      SelectedIndex="{Binding DebugCategoryIndex, Mode=TwoWay}"
                      ToolTip="Game memory category" />
            <ComboBox Width="110" Margin="6,0,0,0"
                      SelectedIndex="{Binding DebugTypeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="All types" />
                <ComboBoxItem Content="Pointer" />
                <ComboBoxItem Content="Integer" />
                <ComboBoxItem Content="Text" />
                <ComboBoxItem Content="Boolean" />
            </ComboBox>
            <TextBox Width="200" Margin="6,0,0,0"
                     ToolTip="Filter category, name, address, type, value, chain, status, or note"
                     Text="{Binding DebugFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Margin="10,0,0,0"
                      VerticalAlignment="Center"
                      Content="Only problems"
                      IsChecked="{Binding DebugOnlyProblems, Mode=TwoWay}"
                      ToolTip="Hide healthy and optional fields" />
        </WrapPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding DebugFieldsView}"
                  SelectedItem="{Binding SelectedDebugField, Mode=TwoWay}"
                  RowStyle="{StaticResource DebugRowStyle}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Width="100"
                                    Binding="{Binding Category}" />
                <DataGridTextColumn Header="Name" Width="160"
                                    Binding="{Binding Name}" />
                <DataGridTextColumn Header="Address" Width="95"
                                    Binding="{Binding Address}"
                                    ElementStyle="{StaticResource MonoText}" />
                <DataGridTextColumn Header="Type" Width="55"
                                    Binding="{Binding Type}" />
                <DataGridTextColumn Header="Value" Width="170"
                                    Binding="{Binding Value}"
                                    ElementStyle="{StaticResource MonoText}" />
                <DataGridTextColumn Header="Status" Width="85"
                                    Binding="{Binding Status}"
                                    ElementStyle="{StaticResource DebugStatusStyle}" />
                <DataGridTextColumn Header="Chain" Width="*"
                                    Binding="{Binding Chain}"
                                    ElementStyle="{StaticResource MonoText}" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows" />

        <Border Grid.Row="4"
                Style="{StaticResource Card}"
                Padding="10,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Pointer details"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding DebugDetails, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource Text}"
                         FontFamily="Consolas"
                         FontSize="12" />
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding DebugEmptyText}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="380"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Foreground="{DynamicResource TextMuted}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DebugEmptyText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
