<UserControl x:Class="AA2Trainer.WpfPrototype.Views.DebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Definitions" Style="{StaticResource PageTitle}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBox Width="180" ToolTip="Filter (wired in M4)" />
                <ComboBox Width="110" Margin="6,0,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="All types" />
                    <ComboBoxItem Content="Character" />
                    <ComboBoxItem Content="Activity" />
                </ComboBox>
                <CheckBox Content="Only changed" Margin="10,0,0,0"
                          VerticalAlignment="Center" />
                <Button Content="Refresh" Style="{StaticResource ToolbarButton}"
                        Margin="10,0,0,0" />
                <Button Content="Clear" Style="{StaticResource ToolbarButton}"
                        Margin="6,0,0,0" />
            </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding DebugFields}"
                  IsReadOnly="True"
                  AlternatingRowBackground="{DynamicResource SurfaceAlt}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Width="150" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Address" Width="105" Binding="{Binding Address}"
                                    ElementStyle="{StaticResource MonoText}" />
                <DataGridTextColumn Header="Type" Width="55" Binding="{Binding Type}" />
                <DataGridTextColumn Header="Value" Width="150" Binding="{Binding Value}"
                                    ElementStyle="{StaticResource MonoText}" />
                <DataGridTextColumn Header="Note" Width="*" Binding="{Binding Note}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
