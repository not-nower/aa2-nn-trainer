<UserControl x:Class="AA2Trainer.WpfPrototype.Views.DebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Live game memory" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Read-only values read directly from the game."
                       Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBox Width="180"
                         ToolTip="Filter name, address, type, value, or note"
                         Text="{Binding DebugFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Width="110" Margin="6,0,0,0"
                          SelectedIndex="{Binding DebugTypeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="All types" />
                    <ComboBoxItem Content="Pointer" />
                    <ComboBoxItem Content="Integer" />
                    <ComboBoxItem Content="Text" />
                    <ComboBoxItem Content="Boolean" />
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding DebugFieldsView}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  EnableRowVirtualization="True"
                  AlternatingRowBackground="{DynamicResource SurfaceAlt}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Width="180" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Address" Width="105" Binding="{Binding Address}"
                                    ElementStyle="{StaticResource MonoText}" />
                <DataGridTextColumn Header="Type" Width="60" Binding="{Binding Type}" />
                <DataGridTextColumn Header="Value" Width="200" Binding="{Binding Value}"
                                    ElementStyle="{StaticResource MonoText}" />
                <DataGridTextColumn Header="Note" Width="*" Binding="{Binding Note}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
