<UserControl x:Class="AA2Trainer.WpfPrototype.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="OptionSectionTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource SectionHeader}"
                               Margin="8,6,8,4" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Label}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" />

                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding ToggleValue, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Visibility="{Binding IsToggle, Converter={StaticResource BoolToVis}}" />

                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Choices}"
                                              SelectedIndex="{Binding Value, Mode=TwoWay}"
                                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}"
                                              VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsSlider, Converter={StaticResource BoolToVis}}">
                                        <Slider Width="156"
                                                Minimum="{Binding Min}"
                                                Maximum="{Binding Max}"
                                                Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsSnapToTickEnabled="True"
                                                TickFrequency="1"
                                                SmallChange="1"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayValue}"
                                                   Width="60"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding RangeText}"
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Game options" Style="{StaticResource PageTitle}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="{Binding GameOptionsStatus}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="360" />
                <Button Content="Apply"
                        Style="{StaticResource ToolbarButton}"
                        IsEnabled="{Binding CanApplyOptions}"
                        Click="Apply_Click" />
                <Button Content="Revert"
                        Style="{StaticResource ToolbarButton}"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding CanRevertOptions}"
                        Click="Revert_Click" />
            </StackPanel>
            <TextBlock Text="Live values are read from the game; Apply writes only the fields you changed."
                       Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Trainer">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <TextBlock Text="Live session"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="0,0,0,6" />
                                <CheckBox Content="Live refresh"
                                          IsChecked="{Binding LiveRefreshEnabled, Mode=TwoWay}"
                                          Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Refresh interval (ms)"
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding RefreshIntervals}"
                                              SelectedItem="{Binding RefreshIntervalMs, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2"
                                               Text="50-2000 ms. Pausing keeps writes and freezes processing."
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <CheckBox Content="Observe only (planner hook)"
                                          IsChecked="{Binding PlannerObserveOnly, Mode=OneWay}"
                                          IsEnabled="{Binding CanToggleObserve}"
                                          Checked="Observe_Changed"
                                          Unchecked="Observe_Changed"
                                          Margin="0,0,0,4" />
                                <TextBlock Text="{Binding PlannerHookState}"
                                           Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <TextBlock Text="Save backups"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding CurrentSavePath}"
                                           Style="{StaticResource CaptionText}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CurrentSavePath}"
                                           Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Backup now"
                                            Width="100"
                                            IsEnabled="{Binding CanBackup}"
                                            Click="Backup_Click" />
                                    <Button Content="Restore..."
                                            Width="92"
                                            Margin="6,0,0,0"
                                            IsEnabled="{Binding CanBackup}"
                                            Click="Restore_Click" />
                                </StackPanel>
                                <TextBlock Text="{Binding BackupStatus}"
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="8">
                                <TextBlock Text="Name tables"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Update from XMLs..."
                                            Width="140"
                                            Click="UpdateNames_Click" />
                                    <Button Content="Reload"
                                            Width="76"
                                            Margin="6,0,0,0"
                                            Click="ReloadNames_Click" />
                                </StackPanel>
                                <TextBlock Text="{Binding NameTableStatus}"
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="System">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SystemOptionSections}"
                                  ItemTemplate="{StaticResource OptionSectionTemplate}"
                                  Margin="0,8,0,0" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Sound">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SoundOptionSections}"
                                  ItemTemplate="{StaticResource OptionSectionTemplate}"
                                  Margin="0,8,0,0" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Additional (1)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Additional1OptionSections}"
                                  ItemTemplate="{StaticResource OptionSectionTemplate}"
                                  Margin="0,8,0,0" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Additional (2)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Additional2OptionSections}"
                                  ItemTemplate="{StaticResource OptionSectionTemplate}"
                                  Margin="0,8,0,0" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Additional (3)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Additional3OptionSections}"
                                  ItemTemplate="{StaticResource OptionSectionTemplate}"
                                  Margin="0,8,0,0" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
