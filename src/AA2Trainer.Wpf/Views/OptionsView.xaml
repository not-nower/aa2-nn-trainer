<UserControl x:Class="AA2Trainer.WpfPrototype.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="Trainer" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <CheckBox Content="Live refresh" IsChecked="True" Margin="0,0,0,6" />
                    <CheckBox Content="Observe only" Margin="0,0,0,6" />
                    <CheckBox Content="Use planner hook" IsChecked="True" Margin="0,0,0,6" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Refresh interval (ms)"
                                   Style="{StaticResource CaptionText}" />
                        <TextBox Grid.Column="1" Text="250" />
                        <TextBlock Grid.Column="2" Text="Adaptive polling stays on."
                                   Style="{StaticResource CaptionText}"
                                   Margin="10,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Save backups" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <CheckBox Content="Create a backup before restore" IsChecked="True"
                              Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Backup now" Width="100" />
                        <Button Content="Restore..." Width="92" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Backups live beside the save with a timestamp."
                               Style="{StaticResource CaptionText}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Name tables" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Update from XMLs..." Width="140" />
                        <Button Content="Reload" Width="76" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Portable NameData.local.tsv stays beside the exe."
                               Style="{StaticResource CaptionText}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
