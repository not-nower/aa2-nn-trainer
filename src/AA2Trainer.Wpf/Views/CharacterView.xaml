<UserControl x:Class="AA2Trainer.WpfPrototype.Views.CharacterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl>
        <TabItem Header="Data">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="12" MaxWidth="820" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="4"
                               Text="Identity"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,6" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="First name"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding SelectedSeat.FirstName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,16,6" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Last name"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBox Grid.Row="1" Grid.Column="3"
                             Text="{Binding SelectedSeat.LastName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,6" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Nickname"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding SelectedSeat.Nickname, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,16,6" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Relationship"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBox Grid.Row="2" Grid.Column="3"
                             Text="{Binding SelectedSeat.Relationship, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,6" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Profile"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                             Text="{Binding SelectedSeat.Profile, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Height="72"
                             Margin="0,0,0,10" />

                    <TextBlock Grid.Row="4" Grid.ColumnSpan="4"
                               Text="Status"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,6" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Mood"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Text="{Binding SelectedSeat.Mood, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,16,6" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Energy"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBox Grid.Row="5" Grid.Column="3"
                             Text="{Binding SelectedSeat.Energy, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,6" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Study"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBox Grid.Row="6" Grid.Column="1"
                             Text="{Binding SelectedSeat.Study, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,16,6" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="Training"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBox Grid.Row="6" Grid.Column="3"
                             Text="{Binding SelectedSeat.Training, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,6" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Club"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBox Grid.Row="7" Grid.Column="1"
                             Text="{Binding SelectedSeat.Club, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,16,6" />

                    <Border Grid.Row="8" Grid.ColumnSpan="4"
                            Height="1"
                            Background="{DynamicResource Border}"
                            Margin="0,10,0,10" />

                    <StackPanel Grid.Row="9" Grid.ColumnSpan="4"
                                Orientation="Horizontal">
                        <Button Content="Apply" Width="76"
                                Click="Apply_Click" />
                        <Button Content="Revert" Width="76" Margin="6,0,0,0"
                                Click="Revert_Click" />
                        <TextBlock x:Name="CharacterNote"
                                   Style="{StaticResource CaptionText}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Prototype: writes are wired in M2." />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Traits">
            <TextBlock Text="Prototype - Traits in M2."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
        <TabItem Header="Body">
            <TextBlock Text="Prototype - Body in M2."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
        <TabItem Header="Face">
            <TextBlock Text="Prototype - Face in M2."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
        <TabItem Header="Hair">
            <TextBlock Text="Prototype - Hair in M2."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
        <TabItem Header="Outfits">
            <TextBlock Text="Prototype - Outfits in M2."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
        <TabItem Header="Import/Export">
            <TextBlock Text="Prototype - Import/Export in M2."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
    </TabControl>
</UserControl>
