<UserControl x:Class="AA2Trainer.WpfPrototype.Views.CharacterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl>
        <TabItem Header="Data">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="12" MaxWidth="860" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="4"
                               Text="Identity"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,6" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="First name"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding SelectedSeat.FirstName}"
                             IsReadOnly="True"
                             Margin="0,0,16,6" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Last name"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBox Grid.Row="1" Grid.Column="3"
                             Text="{Binding SelectedSeat.LastName}"
                             IsReadOnly="True"
                             Margin="0,0,0,6" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Relationship"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding SelectedSeat.Relationship}"
                             IsReadOnly="True"
                             Margin="0,0,16,6" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Profile"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                             Text="{Binding SelectedCharacter.Profile}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Height="72"
                             Margin="0,0,0,10" />

                    <TextBlock Grid.Row="4" Grid.ColumnSpan="4"
                               Text="Attributes"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,6" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Personality"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="5" Grid.Column="1"
                               Text="{Binding SelectedCharacter.Personality}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,16,6" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Club"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="5" Grid.Column="3"
                               Text="{Binding SelectedCharacter.Club}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,6" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Social"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="6" Grid.Column="1"
                               Text="{Binding SelectedCharacter.Social}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,16,6" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="Fighting style"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="6" Grid.Column="3"
                               Text="{Binding SelectedCharacter.FightingStyle}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,6" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Virtue"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="7" Grid.Column="1"
                               Text="{Binding SelectedCharacter.Virtue}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,16,6" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Text="Orientation"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="7" Grid.Column="3"
                               Text="{Binding SelectedCharacter.Orientation}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,6" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Voice pitch"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="8" Grid.Column="1"
                               Text="{Binding SelectedCharacter.VoicePitch}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,16,6" />

                    <TextBlock Grid.Row="9" Grid.ColumnSpan="4"
                               Text="Academics"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,6,0,6" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Intelligence"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3"
                               Text="{Binding SelectedCharacter.Intelligence}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,4" />

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Strength"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="3"
                               Text="{Binding SelectedCharacter.Strength}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,4" />

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Club stats"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="3"
                               Text="{Binding SelectedCharacter.ClubStats}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,6" />

                    <TextBlock Grid.Row="13" Grid.ColumnSpan="4"
                               Text="Status"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,6,0,6" />

                    <TextBlock Grid.Row="14" Grid.Column="0" Text="Record"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="3"
                               Text="{Binding SelectedCharacter.Record}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4" />

                    <TextBlock Grid.Row="15" Grid.Column="0" Text="Experience"
                               Style="{StaticResource CaptionText}" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="3"
                               Text="{Binding SelectedCharacter.Experience}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6" />

                    <Border Grid.Row="16" Grid.ColumnSpan="4"
                            Height="1"
                            Background="{DynamicResource Border}"
                            Margin="0,10,0,10" />

                    <StackPanel Grid.Row="17" Grid.ColumnSpan="4"
                                Orientation="Horizontal">
                        <Button Content="Apply" Width="76"
                                IsEnabled="False"
                                Click="Apply_Click" />
                        <Button Content="Revert" Width="76" Margin="6,0,0,0"
                                IsEnabled="False"
                                Click="Revert_Click" />
                        <TextBlock x:Name="CharacterNote"
                                   Style="{StaticResource CaptionText}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Read-only view; writes are next." />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Traits">
            <TextBlock Text="Prototype - Traits in M2."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
        <TabItem Header="Body">
            <TextBlock Text="Prototype - Body in M2."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
        <TabItem Header="Face">
            <TextBlock Text="Prototype - Face in M2."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
        <TabItem Header="Hair">
            <TextBlock Text="Prototype - Hair in M2."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
        <TabItem Header="Outfits">
            <TextBlock Text="Prototype - Outfits in M2."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
        <TabItem Header="Import/Export">
            <TextBlock Text="Prototype - Import/Export in M2."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </TabItem>
    </TabControl>
</UserControl>
