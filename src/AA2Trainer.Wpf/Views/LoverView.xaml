<UserControl x:Class="AA2Trainer.WpfPrototype.Views.LoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Set Lover" Style="{StaticResource ToolbarButton}"
                    Click="SetLover_Click" />
            <Button Content="Break Up" Style="{StaticResource ToolbarButton}"
                    Margin="6,0,0,0" Click="BreakUp_Click" />
            <Button Content="Apply days / compatibility"
                    Style="{StaticResource ToolbarButton}"
                    Margin="12,0,0,0"
                    IsEnabled="{Binding CanEditLovers}"
                    Click="ApplyLover_Click" />
            <Button Content="Revert"
                    Style="{StaticResource ToolbarButton}"
                    Margin="6,0,0,0"
                    IsEnabled="{Binding CanEditLovers}"
                    Click="RevertLover_Click" />
            <TextBlock Text="Lover flags are incoming only"
                       Style="{StaticResource CaptionText}"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1">
        <DataGrid
                  ItemsSource="{Binding LoverRows}"
                  SelectedIndex="{Binding SelectedLoverIndex, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Seat / Name"
                                    Width="*"
                                    IsReadOnly="True"
                                    Binding="{Binding SourceText}" />
                <DataGridTemplateColumn Header="Lover" Width="54">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsLover, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip="Set or clear lover in both directions" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Days"
                                    Width="80"
                                    Binding="{Binding Days, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <DataGridTextColumn Header="Compatibility"
                                    Width="110"
                                    Binding="{Binding Compatibility, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding LoverEmptyText}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="360"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Foreground="{DynamicResource TextMuted}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LoverEmptyText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding LoverEditStatus}"
                       Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
