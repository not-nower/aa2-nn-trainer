<UserControl x:Class="AA2Trainer.WpfPrototype.Views.RosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AA2Trainer.WpfPrototype.Views">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Class roster" Style="{StaticResource PageTitle}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBox Width="170"
                         Text="{Binding RosterFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by name, room, action, status, or seat"
                         VerticalAlignment="Center" />
                <ComboBox Width="118" Margin="6,0,0,0"
                          SelectedIndex="{Binding SeatFilterIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="All seats" />
                    <ComboBoxItem Content="Students" />
                    <ComboBoxItem Content="Teachers" />
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <ListBox x:Name="RosterList" Grid.Row="1"
                 ItemsSource="{Binding Seats}"
                 SelectedItem="{Binding SelectedSeat, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource CardItemStyle}"
                 VerticalContentAlignment="Stretch"
                 MouseDoubleClick="RosterList_MouseDoubleClick">
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <views:ClassroomRosterPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                    <Border x:Name="CardBorder"
                            Style="{StaticResource Card}"
                            Margin="3"
                            MinHeight="92"
                            Padding="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ToolTip="{Binding DetailTooltip}">
                        <Border.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Play this character"
                                          Click="PlayAs_Click">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPc}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasName}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="Open in Character"
                                          Click="OpenInCharacter_Click" />
                                <Separator />
                                <MenuItem Header="Set Lover"
                                          Click="SetLover_Click"
                                          IsEnabled="{Binding HasRelationship}" />
                                <MenuItem Header="Break Up"
                                          Click="BreakUp_Click"
                                          IsEnabled="{Binding HasRelationship}" />
                                <Separator />
                                <MenuItem Header="Set Love"
                                          Click="SetLove_Click"
                                          IsEnabled="{Binding HasRelationship}" />
                                <MenuItem Header="Set Like"
                                          Click="SetLike_Click"
                                          IsEnabled="{Binding HasRelationship}" />
                                <MenuItem Header="Set Dislike"
                                          Click="SetDislike_Click"
                                          IsEnabled="{Binding HasRelationship}" />
                                <MenuItem Header="Set Hate"
                                          Click="SetHate_Click"
                                          IsEnabled="{Binding HasRelationship}" />
                                <MenuItem Header="Freeze Relationship"
                                          Click="ToggleFreeze_Click"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsFrozen, Mode=OneWay}"
                                          IsEnabled="{Binding HasRelationship}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="68"
                                    Height="80"
                                    Margin="0,0,8,0"
                                    CornerRadius="3"
                                    Background="{DynamicResource AccentSoft}"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="{Binding Initial}"
                                               Foreground="{DynamicResource Accent}"
                                               FontWeight="SemiBold"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Border CornerRadius="3">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding RosterImage}"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4,0"
                                            Margin="3">
                                        <TextBlock Text="{Binding Seat}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Margin="3">
                                        <Border x:Name="TeacherBadge"
                                                Background="{DynamicResource AccentSoft}"
                                                BorderBrush="{DynamicResource AccentSoft}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="4,1"
                                                Margin="0,0,3,0"
                                                Visibility="Collapsed"
                                                ToolTip="Teacher seat">
                                            <TextBlock x:Name="TeacherBadgeText"
                                                       Text="Teacher"
                                                       FontSize="8"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent}" />
                                        </Border>
                                        <Border x:Name="PcBadge"
                                                Background="{DynamicResource Accent}"
                                                BorderBrush="{DynamicResource Accent}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="4,1"
                                                Visibility="Collapsed"
                                                ToolTip="Player character">
                                            <TextBlock Text="PC"
                                                       FontSize="8"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Surface}" />
                                        </Border>
                                    </StackPanel>

                                    <Border x:Name="TargetMini"
                                            Width="28" Height="28"
                                            CornerRadius="14"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0"
                                            Background="{DynamicResource SurfaceAlt}"
                                            BorderBrush="{DynamicResource Surface}"
                                            BorderThickness="1.5"
                                            ClipToBounds="True"
                                            Visibility="Collapsed"
                                            ToolTip="{Binding Target}">
                                        <Grid>
                                            <TextBlock Text="{Binding TargetSeatItem.Initial}"
                                                       Foreground="{DynamicResource Accent}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Border CornerRadius="13">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding TargetSeatItem.RosterImage}"
                                                                Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel x:Name="DetailFields"
                                            Margin="0,1,0,0">
                                    <TextBlock Text="{Binding Personality}"
                                               Style="{StaticResource CaptionText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Location}"
                                               Style="{StaticResource CaptionText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Action}"
                                               Style="{StaticResource CaptionText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Target}"
                                               Style="{StaticResource CaptionText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot"
                                                 Width="7" Height="7"
                                                 Fill="{DynamicResource Success}"
                                                 Margin="0,0,5,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Status}"
                                                   Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Relationship}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="8,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasName}" Value="False">
                            <Setter TargetName="DetailFields" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasTargetSeatItem}" Value="True">
                            <Setter TargetName="TargetMini" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                     Value="True">
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Selection}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsTeacher}" Value="True">
                            <Setter TargetName="TeacherBadge" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPc}" Value="True" />
                                <Condition Binding="{Binding HasName}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PcBadge" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsTeacher}" Value="True" />
                                <Condition Binding="{Binding HasName}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="TeacherBadge" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            <Setter TargetName="TeacherBadge" Property="BorderBrush" Value="{DynamicResource Border}" />
                            <Setter TargetName="TeacherBadgeText" Property="Foreground" Value="{DynamicResource TextMuted}" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Busy">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Warning}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Talking">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Roaming">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Moving">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Approaching">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Warning}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Training">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Facing">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Empty">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource TextDisabled}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRoomUnknown}" Value="True">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource TextMuted}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RosterEmptyText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding RosterEmptyText}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="380"
                       Foreground="{DynamicResource TextMuted}" />
        </Border>
    </Grid>
</UserControl>
