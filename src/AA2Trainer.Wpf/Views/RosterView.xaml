<UserControl x:Class="AA2Trainer.WpfPrototype.Views.RosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AA2Trainer.WpfPrototype.Views">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Class roster" Style="{StaticResource PageTitle}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBox Width="170"
                         Text="{Binding RosterFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by name, room, action, status, or seat"
                         VerticalAlignment="Center" />
                <ComboBox Width="118" Margin="6,0,0,0"
                          SelectedIndex="{Binding SeatFilterIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="All seats" />
                    <ComboBoxItem Content="Students" />
                    <ComboBoxItem Content="Teachers" />
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <ListBox x:Name="RosterList" Grid.Row="1"
                 ItemsSource="{Binding Seats}"
                 SelectedItem="{Binding SelectedSeat, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource CardItemStyle}"
                 VerticalContentAlignment="Stretch">
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <views:ClassroomRosterPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                    <Border x:Name="CardBorder"
                            Style="{StaticResource Card}"
                            Margin="3"
                            MinHeight="92"
                            Padding="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ToolTip="{Binding DetailTooltip}">
                        <Border.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Play this character"
                                          Click="PlayAs_Click">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPc}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasName}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="Open in Character"
                                          Click="OpenInCharacter_Click" />
                                <Separator />
                                <MenuItem Header="Set Lover"
                                          Click="SetLover_Click"
                                          IsEnabled="{Binding HasRelationship}" />
                                <MenuItem Header="Break Up"
                                          Click="BreakUp_Click"
                                          IsEnabled="{Binding HasRelationship}" />
                                <Separator />
                                <MenuItem Header="Set Love"
                                          Click="SetLove_Click"
                                          IsEnabled="{Binding HasRelationship}" />
                                <MenuItem Header="Set Like"
                                          Click="SetLike_Click"
                                          IsEnabled="{Binding HasRelationship}" />
                                <MenuItem Header="Set Dislike"
                                          Click="SetDislike_Click"
                                          IsEnabled="{Binding HasRelationship}" />
                                <MenuItem Header="Set Hate"
                                          Click="SetHate_Click"
                                          IsEnabled="{Binding HasRelationship}" />
                                <MenuItem Header="Freeze Relationship"
                                          Click="ToggleFreeze_Click"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsFrozen, Mode=OneWay}"
                                          IsEnabled="{Binding HasRelationship}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="68" Height="80"
                                    CornerRadius="3"
                                    Background="{DynamicResource AccentSoft}"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="{Binding Initial}"
                                               Foreground="{DynamicResource Accent}"
                                               FontWeight="SemiBold"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding RosterImage}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,68,80"
                                                               RadiusX="3"
                                                               RadiusY="3" />
                                        </Image.Clip>
                                    </Image>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4,0"
                                            Margin="3">
                                        <TextBlock Text="{Binding Seat}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </Border>
                                    <Border x:Name="TeacherBadge"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Background="{DynamicResource AccentSoft}"
                                            BorderBrush="{DynamicResource AccentSoft}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4,1"
                                            Margin="3"
                                            Visibility="Collapsed"
                                            ToolTip="Teacher seat">
                                        <TextBlock x:Name="TeacherBadgeText"
                                                   Text="Teacher"
                                                   FontSize="8"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding RoomAction}"
                                           Style="{StaticResource CaptionText}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{Binding DetailLine}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,1,0,0"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextMuted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DetailLine}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse x:Name="StatusDot"
                                             Width="7" Height="7"
                                             Fill="{DynamicResource Success}"
                                             Margin="0,0,5,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Status}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Relationship}"
                                               Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                     Value="True">
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Selection}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsTeacher}" Value="True">
                            <Setter TargetName="TeacherBadge" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsTeacher}" Value="True" />
                                <Condition Binding="{Binding HasName}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="TeacherBadge" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            <Setter TargetName="TeacherBadge" Property="BorderBrush" Value="{DynamicResource Border}" />
                            <Setter TargetName="TeacherBadgeText" Property="Foreground" Value="{DynamicResource TextMuted}" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Busy">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Warning}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Talking">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Roaming">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource TextMuted}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Moving">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Approaching">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Warning}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Training">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Facing">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource TextMuted}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Empty">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource TextDisabled}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRoomUnknown}" Value="True">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource TextMuted}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
