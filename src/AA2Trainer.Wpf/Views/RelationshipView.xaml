<UserControl x:Class="AA2Trainer.WpfPrototype.Views.RelationshipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CellNumberBox" TargetType="TextBox">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
        <Style x:Key="CellLevelCombo" TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Set Love" Style="{StaticResource ToolbarButton}"
                    Click="Love_Click" />
            <Button Content="Set Like" Style="{StaticResource ToolbarButton}"
                    Margin="6,0,0,0" Click="Like_Click" />
            <Button Content="Set Dislike" Style="{StaticResource ToolbarButton}"
                    Margin="6,0,0,0" Click="Dislike_Click" />
            <Button Content="Set Hate" Style="{StaticResource ToolbarButton}"
                    Margin="6,0,0,0" Click="Hate_Click" />
            <Button Content="Freeze / Unfreeze" Style="{StaticResource ToolbarButton}"
                    Margin="12,0,0,0" Click="Freeze_Click" />
            <TextBlock Text="C / P / L = count, points, level."
                       ToolTip="C = count, P = points, L = level"
                       Style="{StaticResource CaptionText}"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid Grid.Row="1">
        <DataGrid
                  x:Name="RelationshipGrid"
                  ItemsSource="{Binding RelationshipRows}"
                  SelectedIndex="{Binding SelectedRelationshipIndex, Mode=TwoWay}"
                  SelectionUnit="FullRow"
                  SelectionMode="Single"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  PreviewMouseLeftButtonDown="RelationshipGrid_PreviewMouseLeftButtonDown"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Seat / Name"
                                    Width="*"
                                    MinWidth="140"
                                    IsReadOnly="True"
                                    Binding="{Binding SourceText}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding SourceText}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Love C/P/L" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource CellNumberBox}"
                                         ToolTip="Love count (0-30)"
                                         Text="{Binding Love.Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource CellNumberBox}"
                                         ToolTip="Love points (0-29)"
                                         Text="{Binding Love.Points, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource CellLevelCombo}"
                                          ItemsSource="{Binding Love.LevelChoices}"
                                          SelectedIndex="{Binding Love.LevelIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Love level" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Like C/P/L" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource CellNumberBox}"
                                         ToolTip="Like count (0-30)"
                                         Text="{Binding Like.Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource CellNumberBox}"
                                         ToolTip="Like points (0-29)"
                                         Text="{Binding Like.Points, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource CellLevelCombo}"
                                          ItemsSource="{Binding Like.LevelChoices}"
                                          SelectedIndex="{Binding Like.LevelIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Like level" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Dislike C/P/L" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource CellNumberBox}"
                                         ToolTip="Dislike count (0-30)"
                                         Text="{Binding Dislike.Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource CellNumberBox}"
                                         ToolTip="Dislike points (0-29)"
                                         Text="{Binding Dislike.Points, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource CellLevelCombo}"
                                          ItemsSource="{Binding Dislike.LevelChoices}"
                                          SelectedIndex="{Binding Dislike.LevelIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Dislike level" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Hate C/P/L" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource CellNumberBox}"
                                         ToolTip="Hate count (0-30)"
                                         Text="{Binding Hate.Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource CellNumberBox}"
                                         ToolTip="Hate points (0-29)"
                                         Text="{Binding Hate.Points, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource CellLevelCombo}"
                                          ItemsSource="{Binding Hate.LevelChoices}"
                                          SelectedIndex="{Binding Hate.LevelIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Hate level" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Latest" Width="72">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Height="22"
                                      MinHeight="22"
                                      Margin="1,0"
                                      ItemsSource="{Binding LatestChoices}"
                                      SelectedIndex="{Binding LatestIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding HasHistory}"
                                      ToolTip="Newest feeling change" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridCheckBoxColumn Header="Lover"
                                        Width="42"
                                        IsReadOnly="True"
                                        Binding="{Binding IsLover, Mode=OneWay}" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding RelationshipEmptyText}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="360"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Foreground="{DynamicResource TextMuted}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelationshipEmptyText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Apply"
                        Style="{StaticResource ToolbarButton}"
                        IsEnabled="{Binding CanApplyRelationship}"
                        Click="ApplyRelationship_Click" />
                <Button Content="Revert"
                        Style="{StaticResource ToolbarButton}"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding CanRevertRelationship}"
                        Click="RevertRelationship_Click" />
            </StackPanel>
            <TextBlock Text="{Binding RelationshipEditStatus}"
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
