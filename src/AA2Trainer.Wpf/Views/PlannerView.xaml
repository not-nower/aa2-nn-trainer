<UserControl x:Class="AA2Trainer.WpfPrototype.Views.PlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{Binding PlanStatus}"
                       Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox Content="Repeat" Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                <CheckBox Content="Shuffle" Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                <ComboBox Width="118" SelectedIndex="2" ToolTip="Plan mode"
                          Margin="0,0,6,0">
                    <ComboBoxItem Content="Normal" />
                    <ComboBoxItem Content="Forced" />
                    <ComboBoxItem Content="Forced perform" />
                    <ComboBoxItem Content="Ignore" />
                </ComboBox>
                <ComboBox Width="78" SelectedIndex="0"
                          ToolTip="Who starts the interaction">
                    <ComboBoxItem Content="Actor" />
                    <ComboBoxItem Content="Target" />
                    <ComboBoxItem Content="Either" />
                </ComboBox>
                <Border Style="{StaticResource Pill}" Margin="10,0,0,0">
                    <TextBlock Text="{Binding HookState}"
                               FontSize="10"
                               Foreground="{DynamicResource Success}" />
                </Border>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="258" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding PlanSteps}"
                      SelectedIndex="2"
                      IsReadOnly="False"
                      Margin="0,0,0,8">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="On"
                                            Width="34"
                                            Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="#"
                                        Width="32"
                                        IsReadOnly="True"
                                        Binding="{Binding Number}" />
                    <DataGridTextColumn Header="Step"
                                        Width="*"
                                        IsReadOnly="True"
                                        Binding="{Binding Description}" />
                    <DataGridTemplateColumn Header="State" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="StateText"
                                           Text="{Binding State}"
                                           VerticalAlignment="Center" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="done">
                                        <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="skipped">
                                        <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource TextMuted}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="running">
                                        <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="failed">
                                        <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow"
                           BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip" Value="{Binding Note}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="skipped">
                                <Setter Property="Opacity" Value="0.62" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel Margin="8">
                        <TextBlock Text="New step" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Target" Style="{StaticResource CaptionText}" Margin="0,0,0,2" />
                                <ComboBox SelectedIndex="0" ToolTip="Target NPC">
                                    <ComboBoxItem Content="00 Reiya" />
                                    <ComboBoxItem Content="01 Yuu" />
                                    <ComboBoxItem Content="02 Kazaho" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="About" Style="{StaticResource CaptionText}" Margin="0,0,0,2" />
                                <ComboBox SelectedIndex="0">
                                    <ComboBoxItem Content="None" />
                                    <ComboBoxItem Content="01 - Yuu Ayase" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Action" Style="{StaticResource CaptionText}" Margin="0,0,0,2" />
                                <ComboBox SelectedIndex="0">
                                    <ComboBoxItem Content="44 - Pet" />
                                    <ComboBoxItem Content="45 - Hug" />
                                    <ComboBoxItem Content="0 - Encourage" />
                                    <ComboBoxItem Content="18 - Talk About Love" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Room" Style="{StaticResource CaptionText}" Margin="0,0,0,2" />
                                <ComboBox SelectedIndex="0">
                                    <ComboBoxItem Content="None" />
                                    <ComboBoxItem Content="10 - Outside Toilets" />
                                    <ComboBoxItem Content="12 - Classroom" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Add action" />
                            <Button Grid.Column="2" Content="Add move" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Start plan" Style="{StaticResource ToolbarButton}"
                        Click="Start_Click" />
                <Button Content="Stop plan" Style="{StaticResource ToolbarButton}"
                        Margin="6,0,0,0" Click="Stop_Click" />
                <Button Content="Copy plan" Style="{StaticResource ToolbarButton}"
                        Margin="6,0,0,0" IsEnabled="False"
                        ToolTip="Wired in M3" />
                <Button Content="Paste plan" Style="{StaticResource ToolbarButton}"
                        Margin="6,0,0,0" IsEnabled="False"
                        ToolTip="Wired in M3" />
                <Button Content="Save plans" Style="{StaticResource ToolbarButton}"
                        Margin="6,0,0,0" IsEnabled="False"
                        ToolTip="Wired in M3" />
                <Button Content="Load plans" Style="{StaticResource ToolbarButton}"
                        Margin="6,0,0,0" IsEnabled="False"
                        ToolTip="Wired in M3" />
            </StackPanel>
            <TextBlock x:Name="PrototypeNote"
                       Text="Prototype: plan runner is wired in M3."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
