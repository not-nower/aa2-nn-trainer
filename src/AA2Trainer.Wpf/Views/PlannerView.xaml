<UserControl x:Class="AA2Trainer.WpfPrototype.Views.PlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0">
            <ComboBox Width="118" Margin="0,0,6,0"
                      SelectedIndex="{Binding PlannerModeIndex, Mode=TwoWay}"
                      SelectionChanged="PlannerSetting_Changed"
                      ToolTip="Plan mode">
                <ComboBoxItem Content="Normal" />
                <ComboBoxItem Content="Forced Interaction" />
                <ComboBoxItem Content="Forced perform" />
                <ComboBoxItem Content="Ignore" />
            </ComboBox>
            <ComboBox Width="82" Margin="0,0,10,0"
                      SelectedIndex="{Binding PlannerTriggerIndex, Mode=TwoWay}"
                      SelectionChanged="PlannerSetting_Changed"
                      ToolTip="Who starts the interaction">
                <ComboBoxItem Content="Actor" />
                <ComboBoxItem Content="Target" />
                <ComboBoxItem Content="Either" />
            </ComboBox>
            <CheckBox Content="Repeat" Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      IsChecked="{Binding PlannerRepeat, Mode=TwoWay}"
                      Click="PlannerSetting_Changed" />
            <CheckBox Content="Shuffle" Margin="0,0,14,0"
                      VerticalAlignment="Center"
                      IsChecked="{Binding PlannerShuffle, Mode=TwoWay}"
                      Click="PlannerSetting_Changed" />
            <Button Content="{Binding PlannerHookButtonText}"
                    Style="{StaticResource ToolbarButton}"
                    Click="Hook_Click"
                    Margin="0,0,6,0" />
            <Button Content="Repair hook"
                    Style="{StaticResource ToolbarButton}"
                    Click="RepairHook_Click"
                    Margin="0,0,10,0" />
            <CheckBox Content="Observe only"
                      VerticalAlignment="Center"
                      IsChecked="{Binding PlannerObserveOnly, Mode=OneWay}"
                      IsEnabled="{Binding CanToggleObserve}"
                      Checked="Observe_Changed"
                      Unchecked="Observe_Changed"
                      Margin="0,0,10,0" />
            <TextBlock Text="{Binding PlannerHookState}"
                       Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" />
            </WrapPanel>

            <Button x:Name="ModeHelpButton"
                    Grid.Column="1"
                    Content="?"
                    Width="26" Height="26"
                    Margin="6,0,0,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Plan mode help"
                    Click="ModeHelp_Click" />

            <Popup x:Name="ModeHelpPopup"
                   PlacementTarget="{Binding ElementName=ModeHelpButton}"
                   Placement="Bottom"
                   HorizontalOffset="-390"
                   VerticalOffset="4"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Width="430">
                    <StackPanel>
                        <TextBlock Text="Plan modes"
                                   Style="{StaticResource SectionHeader}"
                                   Margin="0,0,0,8" />

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                            <Run FontWeight="SemiBold" Text="Normal" /><Run Text=" — waits for the character to start the interaction; the plan only follows." />
                        </TextBlock>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                            <Run FontWeight="SemiBold" Text="Forced Interaction" /><Run Text=" — arms once the character is already approaching or interacting; it does not force from idle." />
                        </TextBlock>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                            <Run FontWeight="SemiBold" Text="Forced perform" /><Run Text=" — arms immediately even while busy, skips the walk-in, and may use the in-place fallback." />
                        </TextBlock>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                            <Run FontWeight="SemiBold" Text="Ignore" /><Run Text=" — cancels the current action, then arms the step." />
                        </TextBlock>

                        <TextBlock Text="Trigger (Actor / Target / Either) applies to Normal mode."
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Drag a step row with the mouse to reorder the plan."
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
            <DataGrid x:Name="PlannerGrid"
                      ItemsSource="{Binding PlannerSteps}"
                      SelectedIndex="{Binding SelectedPlannerStepIndex, Mode=TwoWay}"
                      IsReadOnly="{Binding PlannerRunning}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AllowDrop="True"
                      PreviewMouseLeftButtonDown="PlannerGrid_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="PlannerGrid_PreviewMouseMove"
                      DragOver="PlannerGrid_DragOver"
                      Drop="PlannerGrid_Drop"
                      Margin="0,0,0,8">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="On"
                                            Width="34"
                                            Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="#"
                                        Width="32"
                                        IsReadOnly="True"
                                        Binding="{Binding Number}" />
                    <DataGridTextColumn Header="Step"
                                        Width="*"
                                        IsReadOnly="True"
                                        Binding="{Binding Description}" />
                    <DataGridTemplateColumn Header="State" Width="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="StateText"
                                           Text="{Binding State}"
                                           VerticalAlignment="Center" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="done">
                                        <Setter TargetName="StateText" Property="Foreground"
                                                Value="{DynamicResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="skipped">
                                        <Setter TargetName="StateText" Property="Foreground"
                                                Value="{DynamicResource TextMuted}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="running">
                                        <Setter TargetName="StateText" Property="Foreground"
                                                Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="failed">
                                        <Setter TargetName="StateText" Property="Foreground"
                                                Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow"
                           BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip" Value="{Binding Note}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="skipped">
                                <Setter Property="Opacity" Value="0.62" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
                <TextBlock Text="No plan steps yet. Add an action or a move."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="320"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource TextMuted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PlannerSteps.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="6">
                    <TextBlock Text="Action Panel"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,6" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Target" Style="{StaticResource CaptionText}"
                                       Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding PlannerTargetOptions}"
                                      SelectedItem="{Binding SelectedPlannerTarget, Mode=TwoWay}"
                                      DisplayMemberPath="Text"
                                      ToolTip="Target NPC" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="About" Style="{StaticResource CaptionText}"
                                       Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding PlannerAboutOptions}"
                                      SelectedItem="{Binding SelectedPlannerAbout, Mode=TwoWay}"
                                      DisplayMemberPath="Text"
                                      ToolTip="About-target NPC" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Action" Style="{StaticResource CaptionText}"
                                       Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding PlannerActions}"
                                      SelectedItem="{Binding SelectedPlannerAction, Mode=TwoWay}"
                                      DisplayMemberPath="Text" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Room" Style="{StaticResource CaptionText}"
                                       Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding PlannerRooms}"
                                      SelectedItem="{Binding SelectedPlannerRoom, Mode=TwoWay}"
                                      DisplayMemberPath="Text" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Add action"
                                IsEnabled="{Binding CanEditPlanner}"
                                Click="AddAction_Click" />
                        <Button Grid.Column="2" Content="Add move"
                                IsEnabled="{Binding CanEditPlanner}"
                                Click="AddMove_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Force Action"
                                IsEnabled="{Binding CanForcePlanner}"
                                ToolTip="Perform this action now, even if the character is busy"
                                Click="ForceAction_Click" />
                        <Button Grid.Column="2" Content="Force Move"
                                IsEnabled="{Binding CanForcePlanner}"
                                ToolTip="Perform this move now, even if the character is busy"
                                Click="ForceMove_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Remove"
                                IsEnabled="{Binding CanRemovePlannerStep}"
                                Click="RemoveStep_Click" />
                        <Button Grid.Column="2" Content="Clear"
                                IsEnabled="{Binding CanEditPlanner}"
                                Click="Clear_Click" />
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Start plan" Style="{StaticResource ToolbarButton}"
                        IsEnabled="{Binding CanStartPlanner}"
                        Click="Start_Click" />
                <Button Content="Stop plan" Style="{StaticResource ToolbarButton}"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding PlannerStopEnabled}"
                        Click="Stop_Click" />
                <Button Content="Copy plan" Style="{StaticResource ToolbarButton}"
                        Margin="12,0,0,0"
                        IsEnabled="{Binding CanCopyPlanner}"
                        Click="Copy_Click" />
                <Button Content="Paste plan" Style="{StaticResource ToolbarButton}"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding CanPastePlanner}"
                        Click="Paste_Click" />
                <Button Content="Save plans" Style="{StaticResource ToolbarButton}"
                        Margin="12,0,0,0"
                        IsEnabled="{Binding IsAttached}"
                        Click="Save_Click" />
                <Button Content="Load plans" Style="{StaticResource ToolbarButton}"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding IsAttached}"
                        Click="Load_Click" />
            </StackPanel>
            <TextBlock Text="{Binding PlannerStatus}"
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>
