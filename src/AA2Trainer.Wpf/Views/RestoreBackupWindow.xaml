<Window x:Class="AA2Trainer.WpfPrototype.Views.RestoreBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore save backup"
        Width="720" Height="460"
        MinWidth="560" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Choose a backup to restore. The current save and its AAU .json sidecar are backed up first. Close AA2Play or return to the title screen before restoring."
                   Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <DataGrid x:Name="BackupGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="BackupGrid_SelectionChanged"
                  MouseDoubleClick="BackupGrid_MouseDoubleClick"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date"
                                    Width="150"
                                    Binding="{Binding Created, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                <DataGridTextColumn Header="Backup"
                                    Width="*"
                                    Binding="{Binding BackupName}" />
                <DataGridTextColumn Header="Save"
                                    Width="150"
                                    Binding="{Binding SaveName}" />
                <DataGridTemplateColumn Header="AAU" Width="48">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding HasAauBackup, Mode=OneWay}"
                                      IsHitTestVisible="False"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Size"
                                    Width="90"
                                    Binding="{Binding Size, StringFormat={}{0:N0} B}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <CheckBox x:Name="ShowAllCheck"
                      Content="Show backups for all saves"
                      VerticalAlignment="Center"
                      Checked="ShowAll_Changed"
                      Unchecked="ShowAll_Changed" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Refresh"
                        Width="76"
                        Click="Refresh_Click" />
                <Button x:Name="RestoreButton"
                        Content="Restore"
                        Width="76"
                        Margin="6,0,0,0"
                        IsEnabled="False"
                        Click="Restore_Click" />
                <Button Content="Cancel"
                        Width="76"
                        Margin="6,0,0,0"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
