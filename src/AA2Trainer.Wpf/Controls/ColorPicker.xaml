<UserControl x:Class="AA2Trainer.WpfPrototype.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="236">
    <StackPanel>
        <TextBlock Text="Color" Style="{StaticResource CaptionText}"
                   Margin="0,0,0,4" />

        <Canvas x:Name="SpectrumCanvas"
                Width="220" Height="140"
                ClipToBounds="True"
                MouseLeftButtonDown="Spectrum_MouseLeftButtonDown"
                MouseMove="Spectrum_MouseMove"
                MouseLeftButtonUp="Spectrum_MouseLeftButtonUp">
            <Image x:Name="SpectrumImage"
                   Width="220" Height="140"
                   Canvas.Left="0" Canvas.Top="0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Ellipse x:Name="SpectrumMarker"
                     Width="12" Height="12"
                     Stroke="White" StrokeThickness="2"
                     IsHitTestVisible="False" />
        </Canvas>

        <Canvas x:Name="HueCanvas"
                Height="18" Margin="0,8,0,0"
                ClipToBounds="True"
                MouseLeftButtonDown="Hue_MouseLeftButtonDown"
                MouseMove="Hue_MouseMove"
                MouseLeftButtonUp="Hue_MouseLeftButtonUp">
            <Border Width="220" Height="18" CornerRadius="3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFF0000" Offset="0" />
                        <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                        <GradientStop Color="#FF00FF00" Offset="0.3333" />
                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                        <GradientStop Color="#FF0000FF" Offset="0.6667" />
                        <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                        <GradientStop Color="#FFFF0000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Ellipse x:Name="HueMarker"
                     Width="10" Height="18"
                     Stroke="White" StrokeThickness="2"
                     IsHitTestVisible="False" />
        </Canvas>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="H" Style="{StaticResource CaptionText}"
                       Margin="0,0,4,0" />
            <TextBox Width="46"
                     Text="{Binding Hue, ElementName=Root, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat={}{0:F0}}" />
            <TextBlock Text="S" Style="{StaticResource CaptionText}"
                       Margin="10,0,4,0" />
            <TextBox Width="46"
                     Text="{Binding Saturation, ElementName=Root, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat={}{0:F0}}" />
            <TextBlock Text="L" Style="{StaticResource CaptionText}"
                       Margin="10,0,4,0" />
            <TextBox Width="46"
                     Text="{Binding Lightness, ElementName=Root, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat={}{0:F0}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
